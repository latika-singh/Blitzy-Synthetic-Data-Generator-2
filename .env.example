# =============================================================================
# Synthetic ERP Data Generation Platform — Project 2 & 3: Agent Engine + Transaction Workflows
# Environment Variable Template
# =============================================================================
#
# Copy this file to .env and replace placeholder values with your actual
# configuration before running the application:
#
#   cp .env.example .env
#
# IMPORTANT: Never commit your .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# Supported providers: "anthropic", "openai", "azure_openai"
LLM_PROVIDER=anthropic

# Primary model identifier used for complex decisions and descriptions.
# Anthropic examples : claude-sonnet-4-20250514
# OpenAI examples    : gpt-4-turbo
LLM_MODEL=claude-sonnet-4-20250514

# Fallback model used when the primary model is unavailable or rate-limited.
# Should be a cheaper / faster model from the same provider.
# Anthropic examples : claude-haiku-4-20250514
# OpenAI examples    : gpt-3.5-turbo
LLM_FALLBACK_MODEL=claude-haiku-4-20250514

# API key for the selected LLM provider.
# *** SECRET — never log, serialize, or commit this value. ***
LLM_API_KEY=your-api-key-here

# Maximum number of tokens the model may generate per completion request.
LLM_MAX_TOKENS=1000

# Sampling temperature (0.0 = deterministic, 1.0 = maximum randomness).
LLM_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Redis Configuration
# -----------------------------------------------------------------------------
# Connection URL for Redis, used for agent state caching, LLM request queuing
# (Streams), event persistence, and agent memory storage.
# Format: redis://[username:password@]host:port/db
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Project 3: Transaction Processing Configuration
# -----------------------------------------------------------------------------
# Number of transactions to process in a single batch during daily simulation.
# Valid range: 10–1000. Higher values use more memory but reduce DB round trips.
TRANSACTION_BATCH_SIZE=100

# Number of GL journal entry lines to post in a single batch.
# Valid range: 50–5000.
GL_POSTING_BATCH_SIZE=500

# Maximum number of concurrent transaction workflows allowed.
# Valid range: 10–500. Limited by database connection pool size.
CONCURRENT_TRANSACTION_LIMIT=100

# Enable or disable in-memory transaction caching for repeat entity lookups.
# Set to "false" to disable caching (useful for debugging or low-memory envs).
ENABLE_TRANSACTION_CACHING=true

# -----------------------------------------------------------------------------
# Project 3: Discrepancy Injection Configuration
# -----------------------------------------------------------------------------
# Master switch to enable/disable discrepancy injection in the simulation.
# Set to "false" to generate clean (discrepancy-free) transaction data.
DISCREPANCY_INJECTION_ENABLED=true

# Target injection rate as a decimal (0.00–1.00). Default 2% of transactions.
# Actual rate will be within ±1% of this target.
DISCREPANCY_DEFAULT_RATE=0.02

# Difficulty distribution as comma-separated easy,medium,hard weights.
# Must sum to 1.00. MVP uses easy/medium only (hard=0.00).
DISCREPANCY_DIFFICULTY_DISTRIBUTION=0.70,0.30,0.00

# -----------------------------------------------------------------------------
# Project 3: Rework Loop Configuration
# -----------------------------------------------------------------------------
# Master switch to enable/disable the intelligent rework loop.
# When disabled, validation failures are logged but not automatically corrected.
REWORK_LOOP_ENABLED=true

# Maximum number of fix attempts per transaction before escalation.
# Valid range: 1–10.
REWORK_LOOP_MAX_ATTEMPTS=3

# Maximum wall-clock time (seconds) allowed for rework loop per transaction.
# Valid range: 10–300.
REWORK_LOOP_TIMEOUT_SECONDS=30

# Failure rate threshold (0.00–1.00) above which rework loop escalates to admin.
# Default 5% — if >5% of transactions fail rework, alert is raised.
REWORK_ESCALATION_THRESHOLD=0.05
